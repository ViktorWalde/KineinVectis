{
  "buildPresets": [
    {
      "configurePreset": "linux-clang-debug-strict",
      "name": "debug-strict"
    },
    {
      "configurePreset": "linux-clang-release-hardened",
      "name": "release-hardened"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build/linux-clang-debug-strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KINEIN_ENABLE_SANITIZERS": "ON",
        "KINEIN_WARNINGS_AS_ERRORS": "ON"
      },
      "displayName": "Linux Clang Debug Strict",
      "generator": "Ninja",
      "name": "linux-clang-debug-strict"
    },
    {
      "binaryDir": "${sourceDir}/build/linux-clang-release-hardened",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KINEIN_ENABLE_HARDENING": "ON",
        "KINEIN_WARNINGS_AS_ERRORS": "ON"
      },
      "displayName": "Linux Clang Release Hardened",
      "generator": "Ninja",
      "name": "linux-clang-release-hardened"
    },
    {
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "displayName": "Debug",
      "generator": "Ninja",
      "name": "debug"
    },
    {
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "displayName": "Release",
      "generator": "Ninja",
      "name": "release"
    }
  ],
  "testPresets": [
    {
      "configurePreset": "linux-clang-debug-strict",
      "name": "debug-strict",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "version": 6
}
