{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinein.dev/schemas/ipc.schema.json",
  "$comment": "Contrato estrutural do protocolo implementado 0.62.0; inclui o diagnostico da compilation database em cmake.status (cdbDirectory/cdbStale/cdbStaleBecause), aditivo e omitido quando nao ha o que reportar; inclui o catalogo de formatters publicado pelo core (format.capabilities), para a UI nao manter uma segunda lista do que e formatavel; inclui gestos de mouse no terminal decididos pelo core (terminal.mouse), forma/piscagem DECSCUSR e largura autoritativa em células no terminal, capacidades híbridas Cargo+CMake, rejeição de semantic tokens LSP obsoletos e workspaces recentes globais. Uma CLI de IA é um programa comum no terminal: nao ha politica por programa no core.",
  "title": "Kinein Vectis IPC",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "jsonRpcId": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": ["workspace.recent.list", "workspace.recent.clear"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": { "type": "object", "maxProperties": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "workspace.recent.pin" } },
            "required": ["method"]
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "required": ["root", "pinned"],
                "additionalProperties": false,
                "properties": {
                  "root": { "type": "string", "pattern": "^/" },
                  "pinned": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "workspace.recent.remove" } },
            "required": ["method"]
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "required": ["root"],
                "additionalProperties": false,
                "properties": {
                  "root": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    },
    "event": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "pattern": "^event\\." },
        "params": { "type": "object" }
      },
      "not": { "required": ["id"] }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PARSE_ERROR",
            "INVALID_REQUEST",
            "METHOD_NOT_FOUND",
            "INVALID_PARAMS",
            "INTERNAL_ERROR",
            "TOOL_NOT_FOUND",
            "FILE_CHANGED"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "details": {}
      }
    }
  }
}
