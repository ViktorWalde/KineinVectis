{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinein.dev/schemas/settings.schema.json",
  "title": "Kinein Vectis Runtime Settings",
  "description": "Schema v1 dos arquivos settings.json global e por workspace.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "formatOnSave": {
      "type": "boolean",
      "default": false
    },
    "editorFontSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 40,
      "default": 14
    },
    "autoClosePairs": {
      "type": "boolean",
      "default": true
    },
    "rigorProfile": {
      "type": "string",
      "enum": [
        "strict",
        "balanced",
        "relaxed"
      ],
      "default": "strict"
    },
    "explorerWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "contextWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "assistantTerminalWidth": {
      "type": "integer",
      "minimum": 300,
      "maximum": 720,
      "default": 640
    },
    "bottomPanelHeight": {
      "type": "integer",
      "minimum": 120,
      "maximum": 700,
      "default": 260
    },
    "outlineWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "outlineCollapsed": {
      "type": "boolean",
      "default": false
    },
    "autoSave": {
      "type": "boolean",
      "default": true,
      "description": "Salva sozinho depois de uma pausa, ao trocar de aba e ao perder o foco (0.123.0)."
    },
    "railExpanded": {
      "type": "boolean",
      "default": false,
      "description": "Trilho lateral com rotulos (0.128.0); preferencia do usuario, fora do layout."
    },
    "layout": {
      "description": "Layout do shell (0.146.0, roadmap 53 §4.4). Substituido inteiro a cada gravacao; um schemaVersion maior que o conhecido e' ignorado e preservado.",
      "type": "object",
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": true,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "leftWindow": {
          "type": "string",
          "enum": [
            "explorer",
            "git"
          ]
        },
        "leftVisible": {
          "type": "boolean"
        },
        "sizes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "explorer": {
              "type": "integer",
              "description": "largura PREFERIDA; a exibida passa pelos limites do ShellController"
            },
            "outline": {
              "type": "integer"
            },
            "bottom": {
              "type": "integer",
              "description": "altura preferida do painel de baixo"
            }
          }
        },
        "outlineCollapsed": {
          "type": "boolean"
        },
        "bottom": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "tab": {
              "type": "string"
            },
            "pinned": {
              "type": "array",
              "description": "Abas fixadas no painel de baixo (0.3.7): ficam na faixa mesmo sem conteudo.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rail": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sides": {
              "type": "object",
              "description": "O trilho de cada area arrastada para o outro lado (0.3.9): id -> left|right.",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              }
            }
          }
        },
        "order": {
          "type": "object",
          "description": "A ordem que o usuario arrastou em cada barra (0.3.9): barra -> chaves dos itens. Chave desconhecida e' ignorada; item novo entra no fim.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "panelWidth": {
      "type": "integer",
      "minimum": 160,
      "maximum": 600
    }
  }
}
