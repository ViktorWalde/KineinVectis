{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinein.dev/schemas/settings.schema.json",
  "title": "Kinein Vectis Runtime Settings",
  "description": "Schema v1 dos arquivos settings.json global e por workspace.",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "formatOnSave": {
      "type": "boolean",
      "default": false
    },
    "editorFontSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 40,
      "default": 14
    },
    "autoClosePairs": {
      "type": "boolean",
      "default": true
    },
    "rigorProfile": {
      "type": "string",
      "enum": ["strict", "balanced", "relaxed"],
      "default": "strict"
    },
    "explorerWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "contextWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "assistantTerminalWidth": {
      "type": "integer",
      "minimum": 300,
      "maximum": 720,
      "default": 640
    },
    "bottomPanelHeight": {
      "type": "integer",
      "minimum": 120,
      "maximum": 700,
      "default": 260
    },
    "outlineWidth": {
      "$ref": "#/$defs/panelWidth"
    },
    "outlineCollapsed": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "panelWidth": {
      "type": "integer",
      "minimum": 160,
      "maximum": 600
    }
  }
}
