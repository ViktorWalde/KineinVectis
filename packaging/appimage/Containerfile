# Debian 12/glibc 2.36 baseline, pinned to the repository's Rust 1.96.1.
# The first AppImage target is x86_64; add a separately audited ARM builder
# instead of silently cross-building from this image.
FROM docker.io/library/rust:1.96.1-bookworm@sha256:d99f7b31f49909348dc59b51f3c95d1efded1701ffb222f095aaab7de3c4abd8

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        desktop-file-utils \
        file \
        appstream \
        libegl1-mesa-dev \
        libfmt-dev \
        libgl1-mesa-dev \
        libxcb-cursor0 \
        libxkbcommon-dev \
        libxkbfile1 \
        libwayland-cursor0 \
        libnss3 \
        libnspr4 \
        libdbus-1-3 \
        libasound2 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libxtst6 \
        libxss1 \
        libgbm1 \
        python3-venv \
        unixodbc-dev \
        ninja-build \
        patchelf \
        pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# O Qt do projeto, inclusive os modulos carregados sob demanda. Os arquivos
# base oficiais incluem SVG, Wayland e Network (52 §14.50, 2026-10-24).
RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir aqtinstall==3.3.0 \
    && /opt/aqt/bin/aqt list-qt linux desktop --modules 6.12.0 linux_gcc_64 \
    && /opt/aqt/bin/aqt install-qt linux desktop 6.12.0 linux_gcc_64 \
        -m qtwebengine qtwebchannel qtpositioning -O /opt/Qt \
    && /opt/Qt/6.12.0/gcc_64/bin/qmake -query QT_VERSION

ENV KINEIN_QT_PREFIX=/opt/Qt/6.12.0/gcc_64
ENV PATH="/opt/Qt/6.12.0/gcc_64/bin:${PATH}"
ENV LANG=C.UTF-8

# Dependencias dos plugins do SDK oficial, conferidas por ldd (52 §14.50).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libxkbcommon-x11-0 libxcb-icccm4 libxcb-keysyms1 \
        libxcb-shape0 libxcb-xkb1 libwayland-egl1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
