# clang-tidy configuration of the C++ core.
#
# Documented in: docs/engineering/static-analysis-clang-tidy.md
#
# Independent of the .clang-tidy at the repository root, which applies to ui/.
#
# Disabled checks, each with its reason. Not verified on core code: the list comes from the
# .clang-tidy of 0.3, and each check is measured again with the first code of the core.
# - bugprone-easily-swappable-parameters: high noise in 0.3. The planned defense is a dedicated
#   type for each domain parameter (docs/engineering/cpp23-rules.md).
# - cppcoreguidelines-avoid-magic-numbers: style only, no associated defect.
# - cppcoreguidelines-non-private-member-variables-in-classes: a data struct
#   with public fields is the form the Core Guidelines ask for (C.2, C.131).
# - modernize-use-trailing-return-type: style only.
#
# A suppression in code only enters as NOLINT(<check>): <reason>, on the line.
InheritParentConfig: false
Checks: >-
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/core/(lib|qt|tests)/.*'
ExcludeHeaderFilterRegex: '.*_autogen/.*'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  # A discarded std::expected result is an error. The list is the default of clang-tidy 23
  # (clang-tidy documentation, bugprone-unused-return-value), pinned here so that it does not
  # change with the version.
  bugprone-unused-return-value.CheckedReturnTypes: '^::std::error_code$;^::std::error_condition$;^::std::errc$;^::std::expected$'
  bugprone-unused-return-value.AllowCastToVoid: false
  cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors: true
  # Processes only through the launcher (docs/architecture/processes-and-trust.md).
  # Matches the qualified name of the called or referenced function: direct and
  # qualified calls, via std::, pointer, macro, using and class method. It does
  # not match constructors. Effectiveness measured by the gate.launcher test
  # (lint preset), with the corpus in tests/gates/launcher/. When the module that
  # creates processes exists, its directory gets its own .clang-tidy without this
  # list, and only that directory.
  # Detached thread (CP.26): std::thread::detach and std::jthread::detach, through
  # the same option, with the corpus in tests/gates/threads/ (gate.detach test).
  # Not verified with libc++: its qualified names may carry an internal namespace.
  # A single line: folded YAML would put a space before each entry.
  bugprone-unsafe-functions.CustomFunctions: '^::(fork|vfork|_Fork|clone|clone3|execl|execle|execlp|execv|execve|execvp|execvpe|execveat|fexecve|posix_spawn|posix_spawnp|pidfd_spawn|pidfd_spawnp|system|popen|syscall|forkpty|daemon|wordexp)$,,creates a process outside the launcher;^::QProcess::(start|startDetached|startCommand|execute|open)$,,creates a process outside the launcher;^::(CreateProcessA|CreateProcessW|CreateProcessAsUserA|CreateProcessAsUserW|CreateProcessWithLogonW|CreateProcessWithTokenW|ShellExecuteA|ShellExecuteW|ShellExecuteExA|ShellExecuteExW|WinExec|_spawnl|_spawnv|_spawnvp|_spawnvpe|_wspawnvp|_wsystem|_popen|_wpopen)$,,creates a process outside the launcher;^::std::(thread|jthread)::detach$,,detached thread: use std::jthread without detach (CP.26)'
