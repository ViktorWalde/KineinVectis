{
  "schemaVersion": 1,
  "defaultTreeMode": "default",
  "modes": {
    "compact": {
      "iconSize": 16,
      "rowHeight": 20
    },
    "default": {
      "iconSize": 20,
      "rowHeight": 24
    },
    "comfortable": {
      "iconSize": 24,
      "rowHeight": 28
    }
  },
  "icons": {
    "kv.tree.file.cmake-lists": {
      "name": "CMakeLists",
      "files": [
        "CMakeLists.txt"
      ],
      "assets": {
        "production": "qml:tree-file-cmakelists"
      }
    },
    "kv.tree.file.project-config": {
      "name": "Project configuration",
      "assets": {
        "base": "project-config.svg"
      }
    },
    "kv.tree.file.sql": {
      "name": "SQL",
      "extensions": [
        ".sql"
      ],
      "assets": {
        "production": "qml:tree-file-sql"
      }
    },
    "kv.tree.file.docker": {
      "name": "Docker",
      "assets": {
        "production": "qml:tree-file-docker"
      }
    },
    "kv.tree.file.c": {
      "name": "C source",
      "assets": {
        "production": "qml:tree-file-c"
      }
    },
    "kv.tree.file.cpp": {
      "name": "C++ source",
      "extensions": [
        ".cc",
        ".cpp",
        ".cxx",
        ".c++"
      ],
      "assets": {
        "production": "qml:tree-file-cpp"
      }
    },
    "kv.tree.file.header-c": {
      "name": "C header",
      "extensions": [
        ".h"
      ],
      "assets": {
        "production": "qml:tree-file-h"
      }
    },
    "kv.tree.file.header-cpp": {
      "name": "C++ header",
      "extensions": [
        ".hh",
        ".hpp",
        ".hxx",
        ".h++",
        ".ipp"
      ],
      "assets": {
        "production": "qml:tree-file-hpp"
      }
    },
    "kv.tree.file.rust": {
      "name": "Rust",
      "assets": {
        "production": "qml:tree-file-rust"
      }
    },
    "kv.tree.file.python": {
      "name": "Python",
      "assets": {
        "production": "qml:tree-file-python"
      }
    },
    "kv.tree.file.yaml": {
      "name": "YAML",
      "assets": {
        "production": "qml:tree-file-yaml"
      }
    },
    "kv.tree.file.markdown": {
      "name": "Markdown",
      "assets": {
        "production": "qml:tree-file-markdown"
      }
    },
    "kv.tree.file.cargo": {
      "name": "Cargo manifest and lockfile",
      "files": [
        "Cargo.toml",
        "Cargo.lock"
      ],
      "assets": {
        "production": "qml:tree-file-cargo"
      }
    },
    "kv.tree.file.makefile": {
      "name": "Make build file",
      "files": [
        "Makefile",
        "GNUmakefile"
      ],
      "extensions": [
        ".mk"
      ],
      "assets": {
        "production": "qml:tree-file-makefile"
      }
    },
    "kv.tree.file.pyproject": {
      "name": "Python project configuration",
      "files": [
        "pyproject.toml"
      ],
      "assets": {
        "production": "qml:tree-file-pyproject"
      }
    },
    "kv.tree.file.ros": {
      "name": "ROS 2 XML",
      "files": [
        "package.xml"
      ],
      "patterns": [
        "*.launch.xml"
      ],
      "assets": {
        "production": "qml:tree-file-ros"
      }
    }
